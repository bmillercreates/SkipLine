# Postgres connection string (postgres:// or postgresql://). On Vercel it comes
# from the database integration automatically. For local development, copy it
# from Vercel or point it at a local Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret used to HMAC-sign pass tokens. Only the server knows it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASS_SIGNING_SECRET="change-me-to-a-long-random-string"

# Optional: time zone the bars are in (decides what "tonight" means).
# NEXT_PUBLIC_APP_TIME_ZONE="America/Chicago"
